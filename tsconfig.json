{
    "compilerOptions":  {
                            "module":  "commonjs",
                            "target":  "ES2020",
                            "outDir":  "out",
                            "lib":  [
                                        "ES2020"
                                    ],
                            "sourceMap":  true,
                            "rootDir":  "src",
                            "strict":  true,
                            "esModuleInterop":  true,
                            "resolveJsonModule":  true,
                            "moduleResolution":  "node",
                            "skipLibCheck":  true,
                            "types":  [
                                          "node",
                                          "vscode"
                                      ]
                        },
    "include":  [
                    "src/**/*.ts",
                    "src/**/*.json"
                ],
    "exclude":  [
                    "src/test/**"
                ]
}
